{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "main": "src/server/worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "database_name": "aleph-t07-auth-diary-db",
      "database_id": "LOCAL_ONLY_NOT_PROVISIONED",
      "migrations_dir": "migrations",
      "binding": "DB"
    }
  ],
  "name": "aleph-t07-auth-diary",
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./dist",
    "run_worker_first": true,
    "binding": "ASSETS"
  }
}
